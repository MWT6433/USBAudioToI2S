IP u_fifo2
  ALIAS : alta_fifo;
  TYPE : alta_fifo;
  PARAMETER
    DATA_WIDTH_WR : 64 INTEGER;
    DATA_WIDTH_RD : 64 INTEGER;
    FIFO_DEPTH_WR : 512 INTEGER;
    SYNC_STAGES : 2 INTEGER;
    SHOW_AHEAD : 1 INTEGER;
    USE_LOGIC : 0 INTEGER;
  END_PARAMETER
END_IP
IP fifo2_mem__0
  TYPE : alta_bram9k;
  PARAMETER
    CLKMODE : 2'h2 BITS;
    PORTA_WRITETHRU : 1'b0 BITS;
    PORTA_OUTREG : 1'b0 BITS;
    PORTB_WRITETHRU : 1'b0 BITS;
    PORTB_OUTREG : 1'b0 BITS;
    PORTA_WIDTH : 5'b00000 BITS;
    PORTB_WIDTH : 5'b00000 BITS;
    PORTA_CLKIN_EN : 1'b1 BITS;
    PORTB_CLKIN_EN : 1'b0 BITS;
    PORTA_CLKOUT_EN : 1'b0 BITS;
    PORTB_CLKOUT_EN : 1'b0 BITS;
    PORTA_RSTIN_EN : 1'b0 BITS;
    PORTB_RSTIN_EN : 1'b1 BITS;
    PORTA_RSTOUT_EN : 1'b0 BITS;
    PORTB_RSTOUT_EN : 1'b1 BITS;
    INIT_VAL : 9216' BITS;
  END_PARAMETER
END_IP
